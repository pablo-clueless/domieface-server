# Copy to .env and adjust. Every value below is the local development default,
# so an empty .env works for `docker compose up`.

# --- Server -----------------------------------------------------------------
PORT=8080

# The single most important setting here. It defaults to "production", and only
# the exact string "development" unlocks the local fallbacks below -- a
# localhost database, MinIO's well-known credentials, and a fixed JWT signing
# key that is committed to this repository.
#
# Defaulting the other way round is how a deployment ends up signing real tokens
# with a published secret, so a missing value fails the boot instead.
ENVIRONMENT=development

# Set to true when the server sits behind a proxy you control -- which includes
# every PaaS (Render, Fly, Railway). Leaving it false there makes the rate
# limiter see one client address for the whole internet and throttle all your
# users against a single shared budget.
#
# Leave it false when the server is directly reachable, or any caller could
# forge X-Forwarded-For and walk straight past the limiter.
TRUST_PROXY_HEADER=false

# --- Database ---------------------------------------------------------------
# Host port the Postgres container publishes on. Change it if something already
# owns 5432 -- a native Postgres service is the usual culprit, and the symptom
# is a confusing "password authentication failed for user domieface", because
# the connection reaches that server rather than the container.
#
# The Makefile derives DATABASE_URL from this and docker compose publishes on
# it, so this one line configures both.
POSTGRES_PORT=5432

# Only set this to point at a database that is not the compose one. Left
# commented out, the Makefile builds it from POSTGRES_PORT above.
#DATABASE_URL=postgres://domieface:domieface@localhost:5432/domieface?sslmode=disable

# --- Tokens -----------------------------------------------------------------
# Required unless ENVIRONMENT=development, and at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Object storage ---------------------------------------------------------
# Leave S3_ENDPOINT empty to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=domieface
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Where clients read objects back from. This is baked into every avatarUrl and
# imageUrl, so it must be reachable from the phone, not just from the server.
S3_PUBLIC_BASE_URL=http://localhost:9000/domieface

PRESIGN_TTL=15m
UPLOAD_GC_AFTER=24h

# --- Documentation ----------------------------------------------------------
# Serves Swagger UI at /docs and the OpenAPI spec at /openapi.yaml. Turn off for
# a deployment that would rather not advertise its surface.
DOCS_ENABLED=true

# --- Keep-alive -------------------------------------------------------------
# Requests the health endpoint on an interval, which keeps the process and its
# database pool warm.
SELF_PING_ENABLED=true
SELF_PING_INTERVAL=10m
SELF_PING_TIMEOUT=10s

# Defaults to this server's own address. That keeps the process warm but will
# NOT stop a platform-as-a-service idling the instance: those decide based on
# traffic reaching their edge router, and a request to our own loopback address
# never gets there. To keep such a host awake, set the public health URL here.
#SELF_PING_URL=https://your-service.example.com/healthz

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_PER_MIN=20
AUTH_RATE_LIMIT_BURST=10
